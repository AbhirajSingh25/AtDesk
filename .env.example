# ==============================================================================
# AtDesk - Commercial Pilot Environment Configuration
# Brand: AtDesk | Parent: The Sorted Club
# Launch: JMD Megapolis, Sector 48, Gurugram, Haryana, India
# ==============================================================================

# 1. Project & Application
PROJECT_NAME="AtDesk"
VERSION="2.0.0-staging"
TAGLINE="Good things, delivered to your desk."
PARENT_BRAND="The Sorted Club"
LAUNCH_LOCATION="JMD Megapolis, Sector 48, Gurugram, Haryana, India"

# 2. Managed PostgreSQL Staging Database
# Example local daemon: postgresql+asyncpg://postgres:your_password@127.0.0.1:5433/atdesk_staging
DATABASE_URL="postgresql+asyncpg://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5433/atdesk_staging"

# 3. Security & JWT
SECRET_KEY="replace-with-a-cryptographically-secure-random-secret-key-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 4. Operational Policies
FLAT_DELIVERY_FEE=25.00
CANCELLATION_WINDOW_SECONDS=120
MIN_SHOP_PREPAID_ALERT_THRESHOLD=1500.00

# 5. Indian DLT SMS Configuration (Gupshup / Exotel)
SMS_PROVIDER="GUPSHUP"
SMS_API_KEY="YOUR_DLT_SMS_API_KEY"
SMS_SENDER_ID="SORTED"
SMS_DLT_PE_ID="1701159876543210987"
SMS_DLT_TEMPLATE_ID="1707161234567890123"
OTP_VALIDITY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=3

# 6. Razorpay Payment Gateway (Test Mode Credentials)
# Test mode keys start with rzp_test_
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_SECRET"
RAZORPAY_WEBHOOK_SECRET="YOUR_WEBHOOK_HMAC_SECRET"

# 7. Private Cloud Storage (AWS S3 ap-south-1 / Mumbai)
STORAGE_BACKEND="S3_PRIVATE"
S3_BUCKET_NAME="atdesk-delivery-proofs-jmd-private"
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
S3_PRESIGNED_EXPIRATION_SECONDS=900
MAX_UPLOAD_SIZE_BYTES=5242880

# 8. Google Maps Platform & GPS Navigation
GOOGLE_MAPS_SERVER_API_KEY="YOUR_GOOGLE_MAPS_SERVER_API_KEY"
JMD_MEGAPOLIS_LATITUDE=28.4162
JMD_MEGAPOLIS_LONGITUDE=77.0425

# 9. Firebase Cloud Messaging (FCM)
FCM_SERVER_KEY="YOUR_FCM_SERVER_KEY"
FCM_PROJECT_ID="atdesk-notifications-pilot"

# 10. Frontend Configuration (Next.js)
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"

