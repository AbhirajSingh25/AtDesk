# ==============================================================================
# AtDesk Production & Staging Environment Variables Template
# A Product of The Sorted Club — JMD Megapolis, Sector 48, Gurugram
# ==============================================================================

# Core System
PROJECT_NAME="AtDesk"
VERSION="2.1.0"
ENVIRONMENT="development"  # development | staging | production

# 1. Managed PostgreSQL Database (Neon / AWS RDS / Render)
DATABASE_URL="postgresql+asyncpg://<username>:<password>@<host>:5432/<database>?ssl=require"

# 2. Authentication & Cryptography
SECRET_KEY="generate_with_python_secrets_token_hex_32"  # Min 32 chars in production
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 days

# 3. CORS Approved Origins (Comma-separated)
ALLOWED_ORIGINS="https://atdesk.thesortedclub.com,https://admin.atdesk.thesortedclub.com,https://runner.atdesk.thesortedclub.com,https://shop.atdesk.thesortedclub.com"

# 4. Razorpay Payment Gateway (Test or Live)
RAZORPAY_KEY_ID="rzp_test_or_rzp_live_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# 5. Indian DLT SMS Configuration (TRAI Compliance)
SMS_PROVIDER="GUPSHUP"  # GUPSHUP | MSG91 | TEST_MOCK (TEST_MOCK is forbidden in production)
SMS_API_KEY="your_sms_gateway_api_key"
SMS_SENDER_ID="SORTED"  # 6-character registered header
SMS_DLT_PE_ID="1701159876543210987"  # 19-digit Principal Entity ID
SMS_DLT_TEMPLATE_ID="1707161234567890123"  # Registered Content Template ID
SMS_GUPSHUP_USERID=""  # Required if using Gupshup user credentials
SMS_GUPSHUP_PASSWORD=""  # Required if using Gupshup user credentials

# 6. Private Cloud Storage for Delivery Photo Proofs (AWS S3 or Cloudflare R2)
STORAGE_BACKEND="S3_PRIVATE"  # S3_PRIVATE | CLOUDFLARE_R2 | LOCAL_ENCRYPTED
S3_BUCKET_NAME="atdesk-delivery-proofs-private"
S3_ENDPOINT_URL=""  # Required for Cloudflare R2 (e.g. https://<account_id>.r2.cloudflarestorage.com)
AWS_REGION="ap-south-1"  # Mumbai Region
AWS_ACCESS_KEY_ID="your_s3_or_r2_access_key_id"
AWS_SECRET_ACCESS_KEY="your_s3_or_r2_secret_access_key"

# 7. Firebase Cloud Messaging (FCM Push Notifications)
FCM_SERVER_KEY="your_fcm_server_key"
FCM_PROJECT_ID="atdesk-notifications-pilot"
FIREBASE_CREDENTIALS_JSON=""  # Path to service account JSON or JSON string
